# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored so credentials stay out of the repo.
# Read by auth/mail_config.php, auth/google_config.php and auth/ai_config.php.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your16charAppPassword
SMTP_FROM_EMAIL=youraddress@gmail.com
SMTP_FROM_NAME=JOF INDIA

# Google "Continue with Google" on the registration page.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# "Web application" → Authorized JavaScript origins: http://localhost
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────
# AI nutritionist assistant (admin dashboard chat widget)
# Provider: Groq — https://console.groq.com  → API Keys
# Read by auth/ai_config.php.
# ─────────────────────────────────────────────────────────────────

# Required. Starts with "gsk_".
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Model ID. Groq retires and renames models regularly, and not every account
# sees the same list — check yours with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# Keeping it here means swapping models never needs a code change.
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI-compatible endpoint. Only change if Groq moves it.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ceiling on a single chat reply.
GROQ_MAX_TOKENS=4096

# Ceiling for plan generation. A whole day of meals is long, and a plan that
# runs out of room comes back as truncated JSON and is rejected. Keep >= 8000.
GROQ_PLAN_MAX_TOKENS=8192

# Reasoning models (gpt-oss, qwen3) think before answering, and that thinking
# is billed as output tokens. "low" produced identical plans ~12x cheaper and
# ~7x faster in testing. Options: low | medium | high. Blank = don't send it.
GROQ_REASONING_EFFORT=low

# 0 = repeatable and literal, 1 = creative. 0.3 suits meal planning:
# varied menus, but it still respects the calorie/macro targets.
GROQ_TEMPERATURE=0.3

# Seconds to wait for a reply before giving up. Plan generation is slow.
GROQ_TIMEOUT=60

# Master switch. "false" hides the chat button everywhere — use it if the
# key expires or you hit the free-tier cap and want the rest of the app
# to carry on working normally.
AI_ASSISTANT_ENABLED=true

# Per-admin daily request cap, enforced by auth/rate_limiter.php, so one
# person can't burn the whole free-tier quota. 0 = no cap.
AI_DAILY_REQUEST_CAP=200
